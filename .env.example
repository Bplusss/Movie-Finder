# Copie ce fichier en ".env" (ou définis ces variables dans ton terminal avec `set`)
# et remplis avec tes vraies valeurs. Ne commite JAMAIS le fichier ".env" lui-même
# (il est déjà exclu via .gitignore).

# Connexion à ta base PostgreSQL (Supabase, Neon, Docker local, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clé API TMDB (gratuite sur https://www.themoviedb.org/settings/api)
# Utilisée UNIQUEMENT côté serveur/scripts (pipeline/import-tmdb.js), jamais envoyée au navigateur.
TMDB_API_KEY=your_tmdb_api_key_here

# Optionnel — uniquement si tu lances pipeline/enrich-llm.js
ANTHROPIC_API_KEY=your_anthropic_api_key_here
